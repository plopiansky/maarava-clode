---
import Base from "../layouts/Base.astro";
import { loadSite, imgOf, paragraphs } from "../lib/content";

const { sec, kind, site } = await loadSite();
const PHONE = site.phone, PHONE_HREF = site.phoneHref, EMAIL = site.email;
const regUrl = site.registerUrl;
const reg = { href: regUrl, target: "_blank", rel: "noopener" };
const hero = sec.hero ?? {};
const rosh = sec.rosh ?? {};
const vision = sec.vision ?? {};
const roshImg = imgOf(rosh.image);
const heroImg = imgOf(hero.image);
const schedule = [
	{ key: "schedule-morning", title: "בוקר", cls: "maroon" },
	{ key: "schedule-noon", title: "אחר הצהריים", cls: "gold" },
	{ key: "schedule-evening", title: "ערב", cls: "maroon" },
];
const gallery = kind("gallery").filter((g: any) => imgOf(g.image));
const featured = gallery.filter((g: any) => g.featured);
const grads = ["#b99a6b,#6d4f2f", "#8f7b5a,#c9b48a", "#5f8a5a,#2f4f35", "#2f3b55,#8a97b5", "#6d4f2f,#e0c08a"];
const galleryHome = gallery.length ? (featured.length ? featured : gallery).slice(0, 5) : grads.map(() => ({}));
const trackCls = ["maroon", "gold", "maroon"];
const trackBg = ["t1", "t2", "t3"];
const pillarCls = ["c-brain", "c-soul", "c-body"];
---
<Base active="home">
<main>
	<section class="hero" id="home" style={heroImg ? `background:linear-gradient(rgba(110,22,50,.84),rgba(88,18,42,.9)),url(${heroImg.src}) center/cover no-repeat #6d1b38` : undefined}>
		<div class="container hero-in">
			<div class="hero-logo"><img src="/logo.jpg" alt="מערבא מכון רובין" width="150" height="150" /></div>
			<h1>{hero.title}</h1>
			<h2>{hero.subtitle}</h2>
			<p class="hero-loc"><svg class="ic"><use href="#i-pin" /></svg>{site.location}</p>
			{sec["hero-tagline"]?.body && <p class="hero-tagline">{sec["hero-tagline"].body}</p>}
			<div class="hero-btns">
				<a {...reg} class="btn btn-white"><svg class="ic"><use href="#i-chevron" /></svg>הרשמה לישיבה</a>
				<a href="/about" class="btn btn-ghost">אודות הישיבה</a>
			</div>
		</div>
	</section>

	<section class="rosh" id="team">
		<div class="container rosh-in">
			<div class="rosh-photo reveal">
				<div class="blob blob1"></div><div class="blob blob2"></div>
				<div class="photo-frame">
					{roshImg ? <img src={roshImg.src} alt={rosh.title} /> :
					<div class="photo-placeholder"><svg viewBox="0 0 24 24"><use href="#i-user" /></svg><span>תמונת ראש הישיבה</span></div>}
				</div>
			</div>
			<div class="rosh-text reveal">
				<span class="pill">ראש הישיבה</span>
				<h2>{rosh.title}</h2>
				<p class="muted">{rosh.subtitle}</p>
				<blockquote>
					<svg class="quote"><use href="#i-quote" /></svg>
					<p>{rosh.body}</p>
				</blockquote>
			</div>
		</div>
	</section>

	<section class="vision" id="about">
		<div class="container">
			<h2 class="vision-title reveal">{vision.title}</h2>
			<div class="card-text reveal">
				{paragraphs(vision.body).map((p) => <p set:html={p} />)}
			</div>
			<h3 class="trio-title reveal">{vision.subtitle}</h3>
			<div class="trio">
				{kind("pillar").map((p: any, i: number) => (
					<article class={`trio-card ${pillarCls[i % 3]} reveal`} style={imgOf(p.image) ? `background-image:linear-gradient(rgba(130,30,60,.85),rgba(110,25,55,.9)),url(${imgOf(p.image)!.src})` : undefined}>
						<div class="trio-ic"><svg><use href={`#i-${p.icon || "user"}`} /></svg></div>
						<h4>{p.title}</h4>
						<p>{p.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="tracks" id="tracks">
		<div class="container">
			<h2 class="sec-title reveal">{sec.tracks?.title}</h2>
			<p class="sec-sub reveal">{sec.tracks?.subtitle}</p>
			<div class="tracks-grid">
				{kind("track").map((t: any, i: number) => (
					<article class={`track ${trackBg[i % 3]} reveal`} style={imgOf(t.image) ? `background-image:linear-gradient(to top,rgba(30,15,20,.92),rgba(30,15,20,.1) 70%),url(${imgOf(t.image)!.src});background-size:cover;background-position:center` : undefined}>
						<div class={`track-ic ${trackCls[i % 3]}`}><svg><use href={`#i-${t.icon || "book"}`} /></svg></div>
						<div class="track-body"><h3>{t.title}</h3><p>{t.text}</p></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="schedule" id="schedule">
		<div class="container">
			<h2 class="sec-title light reveal">{sec.schedule?.title}</h2>
			<p class="sec-sub light reveal">{sec.schedule?.subtitle}</p>
			<div class="sch-grid">
				{schedule.map((s) => (
					<article class={`sch ${s.cls} reveal`}>
						<h3><span class="sch-ic"><svg><use href="#i-clock" /></svg></span>{s.title}</h3>
						<ul>{kind(s.key).map((r: any) => <li><span class="t">{r.time}</span><span>{r.title}</span></li>)}</ul>
					</article>
				))}
			</div>
			{sec.mishmar && <div class="mishmar reveal"><h3>{sec.mishmar.title}</h3><p>{sec.mishmar.body}</p></div>}
		</div>
	</section>

	<section class="approach" id="approach">
		<div class="container">
			<div class="approach-text reveal">{paragraphs(sec.approach?.body).map((p) => <p set:html={p} />)}</div>
			<div class="feat-grid">
				{kind("approach-feature").map((f: any) => <div class="feat reveal"><svg><use href={`#i-${f.icon || "heart"}`} /></svg><span>{f.title}</span></div>)}
			</div>
		</div>
	</section>

	<section class="gallery" id="gallery">
		<div class="container">
			<div class="center"><span class="pill reveal">{sec.gallery?.body}</span></div>
			<h2 class="sec-title reveal">{sec.gallery?.title}</h2>
			<p class="sec-sub reveal">{sec.gallery?.subtitle}</p>
			<div class={`gal-grid${gallery.length && gallery.length < 5 ? " few" : ""}`}>
				{galleryHome.map((g: any, i: number) => {
					const im = imgOf(g.image);
					return <a href="/gallery" class={`g g${i + 1} reveal`} style={im ? undefined : `background:linear-gradient(135deg,${grads[i]})`} aria-label={g.title}>{im && <img src={im.src} alt={g.title || ""} loading="lazy" />}</a>;
				})}
			</div>
			<div class="center gal-more reveal"><a href="/gallery" class="btn btn-maroon">לכל התמונות</a></div>
		</div>
	</section>

	<section class="grads" id="grads">
		<div class="container">
			<h2 class="sec-title reveal">{sec.graduates?.title}</h2>
			<p class="sec-sub reveal">{sec.graduates?.subtitle}</p>
			<div class="grad-grid">
				{kind("graduate").map((g: any) => (
					<article class="grad reveal">
						<div class="grad-ic"><svg><use href={`#i-${g.icon || "award"}`} /></svg></div>
						<h3>{g.title}</h3><p>{g.text}</p>
					</article>
				))}
			</div>
			<div class="bagrut reveal">
				<h3>{sec.bagrut?.title}</h3>
				<ul>{kind("bagrut-point").map((b: any) => <li>{b.title}</li>)}</ul>
			</div>
		</div>
	</section>

	<section class="join" id="join">
		<div class="container">
			<div class="join-card reveal">
				<h2>{sec.join?.title}</h2>
				<p>{sec.join?.body}</p>
				<div class="join-btns">
					<a {...reg} class="btn btn-white"><svg class="ic"><use href="#i-chevron" /></svg>להרשמה</a>
					<a href="#contact" class="btn btn-gold">צור קשר</a>
				</div>
				<div class="join-contact">
					<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
					<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
				</div>
			</div>
		</div>
	</section>
</main>
</Base>
