---
import Icons from "../components/Icons.astro";
import { loadSite } from "../lib/content";
import { REGISTER_URL, PHONE, PHONE_HREF, EMAIL } from "../lib/config";
import "../styles/global.css";

interface Props { active?: "home" | "about" | "staff"; title?: string }
const { active = "home", title = "ישיבת מערבא – מכון רובין" } = Astro.props;
const { sec } = await loadSite();
const regUrl = sec.register?.url || REGISTER_URL;
const reg = { href: regUrl, target: "_blank", rel: "noopener" };
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content="ישיבת מערבא – מכון רובין, מושב מתתיהו. ישיבה תיכונית עם בגרויות מלאות, קודש וחיים." />
	<link rel="icon" href="/logo.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
<div class="topbar">
	<div class="container topbar-in">
		<div class="topbar-links">
			<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
			<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
		</div>
		<div class="topbar-loc"><svg class="ic"><use href="#i-pin" /></svg>מושב מתתיהו</div>
	</div>
</div>

<header class="header">
	<div class="container header-in">
		<a href="/" class="brand">
			<img src="/logo.svg" alt="לוגו מערבא" class="brand-logo" />
			<span class="brand-text"><strong>ישיבת מערבא</strong><small>מכון רובין</small></span>
		</a>
		<nav class="nav" id="nav">
			<a href="/" class={active === "home" ? "active" : ""}>ראשי</a>
			<a href="/about" class={active === "about" ? "active" : ""}>אודות</a>
			<a href="/staff" class={active === "staff" ? "active" : ""}>צוות</a>
			<a {...reg}>הרשמה</a>
			<a href="#contact">צור קשר</a>
		</nav>
		<a {...reg} class="btn btn-maroon header-cta">הרשמה לישיבה</a>
		<button class="burger" id="burger" aria-label="תפריט"><span></span><span></span><span></span></button>
	</div>
</header>


<slot />
<footer class="footer" id="contact">
	<div class="container foot-center">
		<a href="/" class="brand">
			<img src="/logo.svg" alt="" class="brand-logo" />
			<span class="brand-text"><strong>ישיבת מערבא</strong><small>מכון רובין</small></span>
		</a>
		<nav class="foot-nav">
			<a href="/">ראשי</a><a href="/about">אודות</a><a href="/staff" class={active === "staff" ? "active" : ""}>צוות</a><a {...reg}>הרשמה</a><a href="#contact">צור קשר</a>
		</nav>
		<div class="foot-contact-row">
			<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
			<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
		</div>
	</div>
	<div class="copy">© {new Date().getFullYear()} ישיבת מערבא - מכון רובין | מושב מתתיהו</div>
</footer>
<Icons />
<script is:inline src="/script.js"></script>
</body>
</html>
