---
import Icons from "../components/Icons.astro";
import { loadSite } from "../lib/content";
import "../styles/global.css";

interface Props { active?: "home" | "about" | "staff" | "gallery"; title?: string; description?: string; image?: string }
const {
	active = "home",
	title = "ישיבת מערבא – ישיבה תיכונית במושב מתתיהו | מכון רובין",
	description = "ישיבת מערבא – מכון רובין: ישיבה תיכונית במושב מתתיהו (אזור מודיעין) עם בגרויות מלאות בציונים גבוהים, לימוד גמרא ברמה גבוהה, פנימייה ויחס אישי לכל תלמיד. הרשמה לישיבה.",
	image = "/hero.jpg",
} = Astro.props;
const origin = Astro.url.origin;
const canonical = origin + (Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, ""));
const imageUrl = image.startsWith("http") ? image : origin + image;
const { site } = await loadSite();
const PHONE = site.phone, PHONE_HREF = site.phoneHref, EMAIL = site.email;
const regUrl = site.registerUrl;
const reg = { href: regUrl, target: "_blank", rel: "noopener" };
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="robots" content="index, follow, max-image-preview:large" />
	<meta name="theme-color" content="#7a1f3d" />
	<link rel="canonical" href={canonical} />
	<meta property="og:type" content="website" />
	<meta property="og:locale" content="he_IL" />
	<meta property="og:site_name" content="ישיבת מערבא – מכון רובין" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonical} />
	<meta property="og:image" content={imageUrl} />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={imageUrl} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "HighSchool",
		name: "ישיבת מערבא – מכון רובין",
		alternateName: ["מערבא", "ישיבת מערבא", "ישיבה תיכונית מערבא", "Ma'arava Machon Rubin", "Yeshivat Maarava"],
		description,
		url: origin + "/",
		logo: origin + "/logo.jpg",
		image: origin + "/hero.jpg",
		telephone: PHONE,
		email: EMAIL,
		address: { "@type": "PostalAddress", addressLocality: "מושב מתתיהו", addressRegion: "מודיעין", postalCode: "7191900", addressCountry: "IL" },
		areaServed: "Israel",
	})} />
	<link rel="icon" href="/logo.jpg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
<div class="topbar">
	<div class="container topbar-in">
		<div class="topbar-links">
			<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
			<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
		</div>
		<div class="topbar-loc"><svg class="ic"><use href="#i-pin" /></svg>{site.location}</div>
	</div>
</div>

<header class="header">
	<div class="container header-in">
		<a href="/" class="brand">
			<img src="/logo.jpg" alt="לוגו מערבא" class="brand-logo" />
			<span class="brand-text"><strong>ישיבת מערבא</strong><small>מכון רובין</small></span>
		</a>
		<nav class="nav" id="nav">
			<a href="/" class={active === "home" ? "active" : ""}>ראשי</a>
			<a href="/about" class={active === "about" ? "active" : ""}>אודות</a>
			<a href="/staff" class={active === "staff" ? "active" : ""}>צוות</a>
			<a {...reg}>הרשמה</a>
			<a href="#contact">צור קשר</a>
		</nav>
		<a {...reg} class="btn btn-maroon header-cta">הרשמה לישיבה</a>
		<button class="burger" id="burger" aria-label="תפריט"><span></span><span></span><span></span></button>
	</div>
</header>


<slot />
<footer class="footer" id="contact">
	<div class="container foot-center">
		<a href="/" class="brand">
			<img src="/logo.jpg" alt="" class="brand-logo" />
			<span class="brand-text"><strong>ישיבת מערבא</strong><small>מכון רובין</small></span>
		</a>
		<p class="foot-about">ישיבה תיכונית במושב מתתיהו – לימוד גמרא ברמה גבוהה, בגרויות מלאות ופנימייה</p>
		<nav class="foot-nav">
			<a href="/">ראשי</a><a href="/about">אודות</a><a href="/staff" class={active === "staff" ? "active" : ""}>צוות</a><a href="/gallery">גלריה</a><a {...reg}>הרשמה</a><a href="#contact">צור קשר</a>
		</nav>
		<div class="foot-contact-row">
			<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
			<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
		</div>
	</div>
	<div class="copy">© {new Date().getFullYear()} ישיבת מערבא - מכון רובין | מושב מתתיהו</div>
<div class="credit">אתר זה נבנה על ידי בית רבנו 8200 · <a href="mailto:plopiansky@gmail.com" dir="ltr">plopiansky@gmail.com</a></div>
</footer>
<Icons />
<script is:inline src="/script.js"></script>
</body>
</html>
