---
import Icons from "../components/Icons.astro";
import { loadSite } from "../lib/content";
import "../styles/global.css";

interface Props { active?: "home" | "about" | "staff" | "gallery" | "graduates" | "contact"; title?: string; description?: string; image?: string }
const {
	active = "home",
	title = "ישיבת מערבא – ישיבה תיכונית במושב מתתיהו | מכון רובין",
	description = "ישיבת מערבא מכון רובין – ישיבה תיכונית במושב מתתיהו: לימוד גמרא ברמה גבוהה, בגרות מלאה בציונים גבוהים ופנימייה. הרשמה לשנת הלימודים.",
	image = "/hero.jpg",
} = Astro.props;
const origin = Astro.url.origin;
const canonical = origin + (Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, ""));
const imageUrl = image.startsWith("http") ? image : origin + image;
const { site } = await loadSite();
const PHONE = site.phone, PHONE_HREF = site.phoneHref, EMAIL = site.email;
const regUrl = site.registerUrl;
const reg = { href: regUrl, target: "_blank", rel: "noopener" };
const NAV = [
	{ name: "ראשי", path: "/" },
	{ name: "אודות", path: "/about" },
	{ name: "צוות הישיבה", path: "/staff" },
	{ name: "בוגרינו", path: "/graduates" },
	{ name: "גלריה", path: "/gallery" },
	{ name: "צור קשר", path: "/contact" },
];
const current = NAV.find((n) => n.path === Astro.url.pathname.replace(/(.)\/$/, "$1"));
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "HighSchool",
			"@id": origin + "/#school",
			name: "ישיבת מערבא – מכון רובין",
			alternateName: ["מערבא", "ישיבת מערבא", "ישיבה תיכונית מערבא", "Ma'arava Machon Rubin", "Yeshivat Maarava"],
			description,
			url: origin + "/",
			logo: origin + "/logo.png",
			image: origin + "/hero.jpg",
			telephone: site.phone,
			email: site.email,
			address: { "@type": "PostalAddress", addressLocality: "מושב מתתיהו", addressRegion: "מודיעין", postalCode: "7191900", addressCountry: "IL" },
			areaServed: "Israel",
		},
		{ "@type": "WebSite", "@id": origin + "/#website", url: origin + "/", name: "ישיבת מערבא", alternateName: ["מערבא", "ישיבת מערבא מכון רובין"], inLanguage: "he", publisher: { "@id": origin + "/#school" } },
		{
			"@type": "ItemList",
			name: "ניווט באתר",
			itemListElement: NAV.map((n, i) => ({ "@type": "SiteNavigationElement", position: i + 1, name: n.name, url: origin + n.path })),
		},
		...(current && current.path !== "/"
			? [{
					"@type": "BreadcrumbList",
					itemListElement: [
						{ "@type": "ListItem", position: 1, name: "ראשי", item: origin + "/" },
						{ "@type": "ListItem", position: 2, name: current.name, item: origin + current.path },
					],
				}]
			: []),
	],
};
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="robots" content="index, follow, max-image-preview:large" />
	<meta name="theme-color" content="#7a1f3d" />
	<link rel="canonical" href={canonical} />
	<meta property="og:type" content="website" />
	<meta property="og:locale" content="he_IL" />
	<meta property="og:site_name" content="ישיבת מערבא – מכון רובין" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonical} />
	<meta property="og:image" content={imageUrl} />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={imageUrl} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	<link rel="icon" href="/favicon.ico" sizes="any" />
	<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
	<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
<div class="topbar">
	<div class="container topbar-in">
		<div class="topbar-links">
			<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
			<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
		</div>
		<div class="topbar-loc"><svg class="ic"><use href="#i-pin" /></svg>{site.location}</div>
	</div>
</div>

<a {...reg} class="float-reg" aria-label="הרשמה לישיבה">הרשמה לישיבה</a>


<slot />
<footer class="footer" id="footer">
	<div class="container foot-center">
		<a href="/" class="brand">
			<img src="/logo.png" alt="" class="brand-logo" />
			<span class="brand-text"><strong>ישיבת מערבא</strong><small>מכון רובין</small></span>
		</a>
		<p class="foot-about">ישיבה תיכונית במושב מתתיהו – לימוד גמרא ברמה גבוהה, בגרויות מלאות ופנימייה</p>
		<nav class="foot-nav" aria-label="ניווט ראשי">
			<a href="/" class={active === "home" ? "active" : ""}>ראשי</a>
			<a href="/about" class={active === "about" ? "active" : ""}>אודות</a>
			<a href="/staff" class={active === "staff" ? "active" : ""}>צוות</a>
			<a href="/graduates" class={active === "graduates" ? "active" : ""}>בוגרינו</a>
			<a href="/gallery" class={active === "gallery" ? "active" : ""}>גלריה</a>
			<a {...reg}>הרשמה</a>
			<a href="/contact" class={active === "contact" ? "active" : ""}>צור קשר</a>
		</nav>
		<div class="foot-contact-row">
			<a href={`mailto:${EMAIL}`}><svg class="ic"><use href="#i-mail" /></svg><span dir="ltr">{EMAIL}</span></a>
			<a href={PHONE_HREF}><svg class="ic"><use href="#i-phone" /></svg><span dir="ltr">{PHONE}</span></a>
		</div>
	</div>
	<div class="copy">© {new Date().getFullYear()} ישיבת מערבא - מכון רובין | מושב מתתיהו</div>
<div class="credit">אתר זה נבנה על ידי <a href="https://rabenu8200.com" target="_blank" rel="noopener">בית רבנו 8200</a></div>
</footer>
<Icons />
<script is:inline src="/script.js"></script>
</body>
</html>
